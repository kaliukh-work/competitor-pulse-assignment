# Local dev (outside Docker). docker-compose sets these for the container.
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/competitor_pulse?schema=public
PORT=3000

# Six-field cron (with seconds). Every 30s for testing; e.g. "0 */15 * * * *" in prod.
POLL_CRON=*/30 * * * * *
# Max competitors fetched/diffed in parallel per tick.
POLL_CONCURRENCY=10

# Any OpenAI-compatible Chat Completions endpoint.
LLM_BASE_URL=http://localhost:4001/v1
LLM_MODEL=mock-llm
LLM_API_KEY=
LLM_TIMEOUT_MS=10000
